rules_version = '2';

// EazyClinic Storage rules, Phase 0 baseline: DENY EVERYTHING to clients.
//
// Uploads and downloads of medical documents use short-lived signed URLs
// issued by the backend after tenant, role and patient-consent checks.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
