# Backend environment variables (staging). Copy to backend.env (git-ignored) or set
# them in the hosting platform. NEVER commit real values.
APP_ENV=staging
PORT=8080
LOG_LEVEL=info
# Comma-separated exact origins of the web apps. No wildcards.
CORS_ALLOWED_ORIGINS=https://clinic-staging.REPLACE_ME.example
# Firebase project of THIS environment only.
FIREBASE_PROJECT_ID=REPLACE_WITH_staging_FIREBASE_PROJECT_ID
# Credentials: use Application Default Credentials supplied by the platform.
# Do not put service-account JSON or private keys in this file.
# Private Cloud Storage bucket of THIS environment (clinic logos). Required outside dev.
STORAGE_BUCKET=REPLACE_WITH_staging_BUCKET_NAME
# Where this deployment runs (informational; not a tenant property). Data-residency
# enforcement is a later phase.
# DEPLOYMENT_REGION=asia-south1
